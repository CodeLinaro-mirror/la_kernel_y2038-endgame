source "drivers/media/pci/intel/ipu3/Kconfig"
source "drivers/media/pci/intel/ivsc/Kconfig"

config IPU_BRIDGE
	tristate "Intel IPU Sensors Bridge"
	depends on I2C && ACPI
	help
	  The sensors bridge is used by multiple other drivers
	  and may be used optionally there.

